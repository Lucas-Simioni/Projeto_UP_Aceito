# Copie para .env e ajuste. O arquivo .env não vai para o Git.

# development | production   (os testes usam "testing" automaticamente)
APP_ENV=development

# Chave usada para assinar a sessão e os tokens CSRF. Em produção use um valor longo e aleatório:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Banco de dados. Em branco, o desenvolvimento usa SQLite em instance/aceito.db.
# Produção (Neon/Supabase): postgresql://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=
