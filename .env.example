# Modelo das variáveis de ambiente do Aceito!. NÃO coloque valores reais aqui: este arquivo vai para o GitHub.
# Para usar: copie para um arquivo chamado .env (que fica fora do Git) e preencha os valores.
# Em produção (Render), as mesmas variáveis são cadastradas no painel do serviço, não em arquivo.

# Ambiente: development ou production. Em branco = development.
APP_ENV=

# Chave secreta que assina a sessão e os tokens CSRF (mínimo de 32 caracteres em produção).
# Gere uma com:  python -c "import secrets; print(secrets.token_hex(32))"
# Em branco no desenvolvimento = chave fixa de desenvolvimento (insegura, só para uso local).
SECRET_KEY=

# Endereço do banco PostgreSQL (Neon ou Supabase), no formato
#   postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# Em branco no desenvolvimento = SQLite local em instance/aceito.db.
DATABASE_URL=
